# Typeflow Backend Environment Configuration
# Copy this file to .env and adjust values as needed

# Database
# SQLite (local development):
DATABASE_URL=sqlite:///./typeflow.db
# For production with persistent volume:
# DATABASE_URL=sqlite:////app/data/typeflow.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/typeflow

# CORS - Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server
HOST=0.0.0.0
PORT=8000